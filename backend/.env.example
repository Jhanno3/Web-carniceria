# Backend Java/Spring Boot (Railway) — copiar a .env y completar con valores reales en local,
# y configurar las mismas variables en Railway → Project → Variables para el deploy.
# Nunca commitear el .env real.

# --- Supabase ---
# Project Settings → API
SUPABASE_URL=[https://TU_PROYECTO.supabase.co]
# Project Settings → API → JWT Settings → JWKS endpoint (para validar el JWT que manda el frontend,
# ver security.SupabaseJwtAuthFilter en specs/001-autenticacion-y-perfil/plan.md).
SUPABASE_JWKS_URL=[https://TU_PROYECTO.supabase.co/auth/v1/.well-known/jwks.json]
# Service role key — SOLO vive acá (backend). Nunca en el frontend. Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=[SUPABASE_SERVICE_ROLE_KEY]

# --- Base de datos (Postgres de Supabase, vía JPA directo — ver constitution.md sección 7) ---
# Usar el "Session pooler" (botón Connect del dashboard → pestaña Direct connection → Session pooler),
# NO la "Direct connection" ni el "Transaction pooler": la conexión directa de Supabase es IPv6-only
# y muchas redes/hosting (incluido Railway) no tienen salida IPv6, así que no resuelve. El Transaction
# pooler, al ser pooled a nivel de transacción, puede dar problemas con JPA/Hibernate (prepared
# statements). El Session pooler resuelve por IPv4 y se comporta como una conexión normal.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-[REGION].pooler.supabase.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.[PROJECT_REF]
SPRING_DATASOURCE_PASSWORD=[DB_PASSWORD]

# --- MercadoPago ---
# Developers → Tus integraciones → Credenciales → Access Token (empezar con el de TEST, no el de producción).
MERCADOPAGO_ACCESS_TOKEN=[MP_ACCESS_TOKEN]
# Secret para validar que un webhook entrante es realmente de MercadoPago (Developers → Webhooks → Firma secreta).
MERCADOPAGO_WEBHOOK_SECRET=[MP_WEBHOOK_SECRET]

# --- App ---
# Railway inyecta PORT automático; Spring Boot lo lee si server.port=${PORT:8080} en application.properties.
PORT=8080
SPRING_PROFILES_ACTIVE=production
# Dominio del frontend en Vercel, para la config de CORS del backend.
CORS_ALLOWED_ORIGINS=[https://TU_FRONTEND.vercel.app]
# Base URL pública de este backend, para armar la URL de retorno/webhook que recibe MercadoPago.
APP_BASE_URL=[https://TU_BACKEND.up.railway.app]
